<%- include('partials/serviceHeader', { title: service ? 'Edit service' : 'Add service' }) %>
<form method="post" action="<%= service ? '/admin/services/' + service.id + '/edit' : '/admin/services' %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label class="form-label" for="name">Name</label><input class="form-control mb-3" id="name" name="name" maxlength="100" value="<%= service ? service.name : '' %>" required>
<label class="form-label" for="description">Description</label><textarea class="form-control mb-3" id="description" name="description"><%= service ? service.description || '' : '' %></textarea>
<label class="form-label" for="cost">Cost ($)</label><input class="form-control mb-3" type="number" id="cost" name="cost" min="0" max="99999999.99" step="0.01" value="<%= service ? service.cost : '' %>" required>
<label class="form-label" for="duration">Session duration (minutes)</label><input class="form-control mb-3" type="number" id="duration" name="session_duration" min="1" max="4294967295" step="1" value="<%= service ? service.session_duration : '' %>" required>
<label class="form-label" for="active">Active</label><select class="form-select mb-3" id="active" name="is_active"><option value="1" <%= !service || service.is_active ? 'selected' : '' %>>Yes</option><option value="0" <%= service && !service.is_active ? 'selected' : '' %>>No</option></select>
<button class="btn btn-primary">Save service</button> <a href="/admin/services">Cancel</a></form>
<%- include('partials/serviceFooter') %>
