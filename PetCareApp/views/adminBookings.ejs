<%- include('partials/serviceHeader', { title: 'All bookings' }) %>
<p>All appointments are shown in Singapore time. All bookings are considered paid.</p>
<form class="row g-2 mb-4" method="get" action="/admin/bookings"><div class="col-md-3"><label for="status" class="form-label">Status</label><select class="form-select" name="status" id="status"><option value="">All</option><% for (const status of ['pending','confirmed','completed','cancelled']) { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% } %></select></div><div class="col-md-3"><label for="date" class="form-label">Appointment date</label><input class="form-control" type="date" id="date" name="date" value="<%= filters.date || '' %>"></div><div class="col-md-3"><label class="form-label" for="customer">Customer name</label><input class="form-control" id="customer" name="customer" value="<%= filters.customer || '' %>"></div><div class="col-md-3 align-self-end"><button class="btn btn-primary">Filter</button> <a href="/admin/bookings">Reset</a></div></form>
<% if (!bookings.length) { %><p>No bookings found.</p><% } %>
<div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Customer / pet</th><th>Service</th><th>Appointment</th><th>Amount</th><th>Payment</th><th>Status</th><th>Actions</th></tr></thead><tbody><% for (const booking of bookings) { %><tr><td><%= booking.booking_id %></td><td><%= booking.customer_name %> / <%= booking.pet_name %></td><td><%= booking.service_name %></td><td><%= booking.start_at %><br>to <%= booking.end_at %></td><td>$<%= booking.price %></td><td>Paid</td><td><%= booking.status %></td><td><form method="post" action="/admin/bookings/<%= booking.booking_id %>/status" onsubmit="return confirm('Change this booking status?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="current_status" value="<%= booking.status %>"><label class="visually-hidden" for="booking-<%= booking.booking_id %>">New status</label><select class="form-select form-select-sm mb-1" id="booking-<%= booking.booking_id %>" name="status"><% for (const status of ['pending','confirmed','completed','cancelled']) { %><option value="<%= status %>" <%= booking.status === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option><% } %></select><button class="btn btn-outline-primary btn-sm">Update</button></form></td></tr><% } %></tbody></table></div>
<% const query = new URLSearchParams({status: filters.status || '', date: filters.date || '', customer: filters.customer || ''}); %><div class="d-flex gap-3"><% if (page > 1) { query.set('page', page-1); %><a href="/admin/bookings?<%= query.toString() %>">Previous</a><% } %><span>Page <%= page %></span><% if (hasNext) { query.set('page', page+1); %><a href="/admin/bookings?<%= query.toString() %>">Next</a><% } %></div>
<%- include('partials/serviceFooter') %>
