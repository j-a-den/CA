<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Admin Dashboard</h2>

    <div class="card text-center shadow">
      <div class="card-header bg-dark text-white">
        Welcome, <%= session.user.name %>!
      </div>
      <div class="card-body">
        <p class="card-text">As an administrator, you can manage users and view their pet information.</p>
        <a href="/admin/users" class="btn btn-primary">View All Users</a>
        <a href="/admin/services" class="btn btn-primary">Manage Services</a>
        <a href="/admin/bookings" class="btn btn-primary">View All Bookings</a>
      </div>
    </div>
    <section class="mt-4" aria-labelledby="revenue-heading">
      <h3 class="h4" id="revenue-heading">Completed-booking revenue</h3>
      <p>Revenue is based on the appointment date in Singapore time. Payment is assumed to have been made. Only bookings currently marked completed are included.</p>
      <form method="GET" action="/admin/dashboard" class="row g-2 align-items-end mb-3">
        <div class="col-sm-5 col-md-4">
          <label class="form-label" for="revenue-date">Appointment date (Singapore time)</label>
          <input type="date" class="form-control" id="revenue-date" name="date" value="<%= selectedDate %>" min="1000-01-01" max="9999-12-31" required>
        </div>
        <div class="col-auto"><button class="btn btn-primary" type="submit">View revenue</button></div>
        <div class="col-auto"><a class="btn btn-outline-secondary" href="/admin/dashboard">Today</a></div>
      </form>
      <% if (revenueError) { %>
        <div class="alert alert-danger" role="alert"><%= revenueError %></div>
      <% } else { %>
        <p class="fw-semibold">Summary for <time datetime="<%= selectedDate %>"><%= selectedDate %></time></p>
        <div class="row g-3 mb-3">
          <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h4 class="h6 text-muted">Daily revenue</h4>
            <p class="display-6 mb-0" id="daily-revenue">$<%= revenue.totalRevenue %></p>
          </div></div></div>
          <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h4 class="h6 text-muted">Completed bookings</h4>
            <p class="display-6 mb-0" id="completed-count"><%= revenue.completedCount %></p>
          </div></div></div>
        </div>
        <% if (revenue.completedCount === 0) { %><p>No completed bookings for this date.</p><% } %>
        <a href="/admin/bookings?status=completed&amp;date=<%= selectedDate %>">View contributing bookings</a>
        <p class="small text-muted mt-2">Totals reflect current booking statuses and saved booking prices. Changing a booking status can change a previous day's total.</p>
      <% } %>
    </section>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
