<%- include('partials/serviceHeader', { title: 'Invoice INV-' + String(invoice.booking_id).padStart(6,'0') }) %>
<dl class="row"><dt class="col-sm-3">Created (Singapore time)</dt><dd class="col-sm-9"><%= invoice.created_at %></dd><dt class="col-sm-3">Customer</dt><dd class="col-sm-9"><%= invoice.customer_name %></dd><dt class="col-sm-3">Pet</dt><dd class="col-sm-9"><%= invoice.pet_name %></dd><dt class="col-sm-3">Service</dt><dd class="col-sm-9"><%= invoice.service_name %></dd><dt class="col-sm-3">Appointment (Singapore time)</dt><dd class="col-sm-9"><%= invoice.start_at %> to <%= invoice.end_at %></dd><dt class="col-sm-3">Booking status</dt><dd class="col-sm-9"><%= invoice.status %></dd><dt class="col-sm-3">Payment status</dt><dd class="col-sm-9">Paid — considered paid by default; no payment collected</dd><dt class="col-sm-3">Total</dt><dd class="col-sm-9 fw-bold">$<%= invoice.price %></dd></dl>
<p class="text-muted">The amount is saved at checkout. Names reflect current account, pet, and service details.</p><div class="no-print"><button class="btn btn-primary" onclick="window.print()">Print invoice</button> <a href="/invoices">All invoices</a></div>
<%- include('partials/serviceFooter') %>
