<%- include('partials/serviceHeader', { title: 'Manage services' }) %>
<p><a class="btn btn-primary" href="/admin/services/new">Add service</a></p><% if (!services.length) { %><p>No services have been added.</p><% } %>
<div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Cost</th><th>Duration</th><th>Active</th><th>Actions</th></tr></thead><tbody><% for (const service of services) { %><tr><td><%= service.name %></td><td>$<%= service.cost %></td><td><%= service.session_duration %> min</td><td><%= service.is_active ? 'Yes' : 'No' %></td><td><a class="btn btn-outline-primary btn-sm" href="/admin/services/<%= service.id %>/edit">Edit</a><form class="d-inline" method="post" action="/admin/services/<%= service.id %>/delete" onsubmit="return confirm('Delete this service? Services with booking history will be archived. Other services and their cart items will be deleted.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-danger btn-sm">Delete / archive</button></form></td></tr><% } %></tbody></table></div>
<%- include('partials/serviceFooter') %>
